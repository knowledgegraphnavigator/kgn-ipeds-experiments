  "queries": {
    "SQL": "-- Which schools offer a fully online master's in the health professions\n-- and graduate more than 60% of their students within six years?\n--\n-- SQL (DuckDB), run directly against the IPEDS CSVs.\nSELECT\n    i.UNITID                        AS unitid,\n    i.name                          AS institution,\n    o.gr4_rate_150_all_pct          AS grad_rate_6yr,\n    count(*)                        AS online_health_masters\nFROM programs      AS p\nJOIN institutions  AS i ON i.UNITID = p.UNITID\nJOIN outcomes      AS o ON o.UNITID = p.UNITID\nWHERE p.cip_2digit = '51'                       -- Health Professions\n  AND p.awlevel_code = 7                        -- Master's degree\n  AND p.programs_offered_fully_distance > 0     -- offered fully online\n  AND o.gr4_rate_150_all_pct > 60               -- 150% of normal time = 6 years\nGROUP BY i.UNITID, i.name, o.gr4_rate_150_all_pct\nORDER BY grad_rate_6yr DESC;\n",
    "SPARQL": "# Which schools offer a fully online master's in the health professions\n# and graduate more than 60% of their students within six years?\n#\n# SPARQL (rdflib), against an RDF graph built from the same CSVs.\nPREFIX schema: <https://schema.org/>\nPREFIX kgn:    <https://knowledgegraphnavigator.com/vocab/ipeds#>\n\nSELECT ?unitid ?institution ?gradRate6yr (COUNT(?program) AS ?onlineHealthMasters)\nWHERE {\n  ?program a schema:EducationalOccupationalProgram ;\n           schema:provider          ?school ;\n           kgn:cipFamily            ?family ;\n           kgn:awardLevelCode       7 ;          # Master's degree\n           kgn:fullyDistancePrograms ?online .\n  ?family  kgn:cipCode              \"51\" .       # Health Professions\n  ?school  schema:name              ?institution ;\n           kgn:unitid               ?unitid ;\n           kgn:gradRate150All       ?gradRate6yr .\n  FILTER (?online > 0 && ?gradRate6yr > 60)\n}\nGROUP BY ?unitid ?institution ?gradRate6yr\nORDER BY DESC(?gradRate6yr)\n",
    "Cypher": "// Which schools offer a fully online master's in the health professions\n// and graduate more than 60% of their students within six years?\n//\n// Cypher (Kuzu), against a labeled property graph built from the same CSVs.\nMATCH (i:Institution)-[:OFFERS]->(o:Offering)-[:IN_FAMILY]->(f:CipFamily {code: '51'})\nWHERE o.awardLevelCode = 7\n  AND o.fullyDistance > 0\n  AND i.gradRate150All > 60\nRETURN i.unitid         AS unitid,\n       i.name           AS institution,\n       i.gradRate150All AS gradRate6yr,\n       count(o)         AS onlineHealthMasters\nORDER BY gradRate6yr DESC;\n",
    "GQL": "// Which schools offer a fully online master's in the health professions\n// and graduate more than 60% of their students within six years?\n//\n// ISO/IEC 39075:2024 GQL, against the same property graph schema as the\n// Cypher query. Executed with GraphLite (see run_gql.py and the README).\nMATCH (i:Institution)-[:OFFERS]->(o:Offering)-[:IN_FAMILY]->(f:CipFamily {code: '51'})\nWHERE o.awardLevelCode = 7\n  AND o.fullyDistance > 0\n  AND i.gradRate150All > 60\nRETURN i.unitid         AS unitid,\n       i.name           AS institution,\n       i.gradRate150All AS gradRate6yr,\n       count(o)         AS onlineHealthMasters\nGROUP BY i.unitid, i.name, i.gradRate150All\nORDER BY gradRate6yr DESC;\n"
  },
