# How many bachelor's degrees (award level 5) did Arizona State University
# Campus Immersion confer in CIP 11.0701 (Computer Science) in 2023-24?
# RDF 1.1 standard reification: the count is on an rdf:Statement.
PREFIX schema: <https://schema.org/>
PREFIX kgn:    <https://knowledgegraphnavigator.com/vocab/ipeds#>
PREFIX ipeds:  <https://knowledgegraphnavigator.com/id/ipeds/>
PREFIX cip:    <https://knowledgegraphnavigator.com/id/ipeds/cip/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?completions WHERE {
  ?statement rdf:subject        ipeds:104151 ;
             rdf:predicate      kgn:conferredIn ;
             rdf:object         cip:11.0701 ;
             kgn:awardLevelCode 5 ;
             kgn:completions    ?completions .
}
