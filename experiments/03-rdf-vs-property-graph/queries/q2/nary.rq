# Total completions at each award level, across all 45 institutions.
# The CSV totals are the ground truth.
PREFIX schema: <https://schema.org/>
PREFIX kgn:    <https://knowledgegraphnavigator.com/vocab/ipeds#>
PREFIX ipeds:  <https://knowledgegraphnavigator.com/id/ipeds/>
PREFIX cip:    <https://knowledgegraphnavigator.com/id/ipeds/cip/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?level (SUM(?n) AS ?total) WHERE {
  ?offering kgn:awardLevelCode ?level ; kgn:completions ?n .
}
GROUP BY ?level ORDER BY ?level
