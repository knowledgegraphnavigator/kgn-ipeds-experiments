inst:carnegie a schema:PropertyValue ;
    schema:description "IPEDS HD2024 (C21BASIC)" ;
    schema:name "Carnegie Classification 2021: Basic" ;
    schema:value "Special Focus Four-Year: Engineering and Other Technology-Related Schools" .

inst:enrollment a schema:PropertyValue ;
    schema:description "IPEDS EF2024A" ;
    schema:name "Total enrollment, fall 2024" ;
    schema:value 2334 .

inst:geo a schema:GeoCoordinates ;
    schema:latitude 39.483602 ;
    schema:longitude -87.326749 .

inst:graduation-rate a schema:PropertyValue ;
    schema:description "IPEDS GR2024, 2018 cohort" ;
    schema:name "Graduation rate within 150% of normal time" ;
    schema:unitText "percent" ;
    schema:value 78.2 .

inst:opeid a schema:PropertyValue ;
    schema:name "OPE ID" ;
    schema:value "00183000" .

inst:retention-rate a schema:PropertyValue ;
    schema:description "IPEDS EF2024D" ;
    schema:name "Full-time retention rate, fall 2024" ;
