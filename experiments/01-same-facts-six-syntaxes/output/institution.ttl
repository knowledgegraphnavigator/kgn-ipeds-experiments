@prefix inst: <https://knowledgegraphnavigator.com/id/ipeds/152318#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://knowledgegraphnavigator.com/id/ipeds/152318> a schema:CollegeOrUniversity ;
    schema:additionalProperty inst:admit-rate,
        inst:carnegie,
        inst:enrollment,
        inst:graduation-rate,
        inst:retention-rate,
        inst:student-faculty-ratio ;
    schema:address inst:address ;
    schema:alternateName "R-HIT",
        "RHIT",
        "RP",
        "RPI",
        "Rose",
        "Rose Hulman",
        "Rose Hulman Institute",
        "Rose Polytechnic",
        "Rose Polytechnic Institute",
        "Rose-Hulman",
        "Rose-Hulman Institute" ;
    schema:geo inst:geo ;
    schema:identifier inst:opeid,
        inst:unitid ;
    schema:name "Rose-Hulman Institute of Technology" ;
    schema:url <https://www.rose-hulman.edu/> .

inst:address a schema:PostalAddress ;
    schema:addressCountry "US" ;
    schema:addressLocality "Terre Haute" ;
    schema:addressRegion "IN" ;
    schema:postalCode "47803-3920" ;
    schema:streetAddress "5500 Wabash Avenue" .

inst:admit-rate a schema:PropertyValue ;
    schema:description "IPEDS ADM2024 (admits / applicants)" ;
    schema:name "Admission rate, fall 2024" ;
    schema:unitText "percent" ;
